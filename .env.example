# Discord webhook for the #latest-runs channel.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
SPEEDRUN_API_KEY=

# Optional run polling configuration.
CHECK_INTERVAL_SECONDS=25
MONITORED_EVENTS=new,verified,rejected
MONITORED_GAME_IDS=o1yj25r1,268q8o6p
# WEBHOOK_USERNAME=

# Bhop Pro in-game online counter, posted to the same webhook.
# Posts once at startup, then every ONLINE_COUNT_INTERVAL_MINUTES (4 hours).
ONLINE_COUNT_ENABLED=true
ONLINE_COUNT_INTERVAL_SECONDS=10

# Railway sets these automatically.
# PORT=3000
# RAILWAY_VOLUME_MOUNT_PATH=/data
